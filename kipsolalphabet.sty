\cs_new_protected:Npn \kipsol_default_copy_text:n #1
  {
    \str_case:enF { \str_lowercase:n {#1} }
      {
        {actualtext}{ \str_gset:Nn \g_kipsol_default_copy_text_str { actualtext } }
        {invisible}{ \str_gset:Nn \g_kipsol_default_copy_text_str { invisible } }
        {both}{ \str_gset:Nn \g_kipsol_default_copy_text_str { both } }
        {none}{ \str_gset:Nn \g_kipsol_default_copy_text_str { none } }
      }
      {
        \PackageWarning{kipsolalphabet}
          {Unknown~copy-text~mode~`#1';~using~`both'}
        \str_gset:Nn \g_kipsol_default_copy_text_str { both }
      }
  }

