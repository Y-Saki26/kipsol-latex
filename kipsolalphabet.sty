\cs_new_protected:Npn \kipsol_options_reset:
  {
    \fp_set_eq:NN \l_kipsol_scale_fp \g_kipsol_default_scale_fp
    \fp_set_eq:NN \l_kipsol_large_radius_fp \g_kipsol_default_large_radius_fp
    \fp_set_eq:NN \l_kipsol_small_radius_fp \g_kipsol_default_small_radius_fp
    \fp_set_eq:NN \l_kipsol_spoke_offset_fp \g_kipsol_default_spoke_offset_fp
    \fp_set_eq:NN \l_kipsol_pivot_radius_fp \g_kipsol_default_pivot_radius_fp
    \fp_set_eq:NN \l_kipsol_eow_radius_fp \g_kipsol_default_eow_radius_fp
    \fp_set_eq:NN \l_kipsol_padding_fp \g_kipsol_default_padding_fp
    \fp_set_eq:NN \l_kipsol_margin_fp \g_kipsol_default_margin_fp
    \str_set_eq:NN \l_kipsol_copy_text_str \g_kipsol_default_copy_text_str
    \bool_if:NTF \g_kipsol_default_large_radius_auto_bool
      { \bool_set_true:N \l_kipsol_large_radius_auto_bool }
      { \bool_set_false:N \l_kipsol_large_radius_auto_bool }
    \bool_if:NTF \g_kipsol_default_small_radius_auto_bool
      { \bool_set_true:N \l_kipsol_small_radius_auto_bool }
      { \bool_set_false:N \l_kipsol_small_radius_auto_bool }
  }

\cs_new_protected:Npn \kipsol_copy_mode_apply:
  {
    \bool_set_false:N \l_kipsol_copy_actualtext_bool
    \bool_set_false:N \l_kipsol_copy_invisible_bool
    \str_case:Vn \l_kipsol_copy_text_str
      {
        { actualtext } { \bool_set_true:N \l_kipsol_copy_actualtext_bool }
        { invisible } { \bool_set_true:N \l_kipsol_copy_invisible_bool }
        { both }
          {
            \bool_set_true:N \l_kipsol_copy_actualtext_bool
            \bool_set_true:N \l_kipsol_copy_invisible_bool
          }
        { none } { }
      }
  }

\cs_new_protected:Npn \kipsol_resolve_auto_metrics:
  {
    \dim_set:Nn \l_kipsol_xheight_dim { 1ex }
    \hbox_set:Nn \l_kipsol_measure_box { X }
    \dim_set:Nn \l_kipsol_cap_height_dim { \box_ht:N \l_kipsol_measure_box }
    \hbox_set:Nn \l_kipsol_measure_box { p }
    \dim_set:Nn \l_kipsol_descender_depth_dim { \box_dp:N \l_kipsol_measure_box }
    \dim_set:Nn \l_kipsol_center_dim { 0.5 \l_kipsol_xheight_dim }
    \fp_set:Nn \l_kipsol_center_fp { 0.5 }
    \bool_if:NT \l_kipsol_small_radius_auto_bool
      { \fp_set:Nn \l_kipsol_small_radius_fp { 0.5 } }
    \bool_if:NT \l_kipsol_large_radius_auto_bool
      {
        \dim_set:Nn \l_kipsol_large_above_dim
          { \l_kipsol_cap_height_dim - \l_kipsol_center_dim }
        \dim_set:Nn \l_kipsol_large_below_dim
          { \l_kipsol_center_dim + \l_kipsol_descender_depth_dim }
        \dim_compare:nNnTF { \l_kipsol_large_above_dim } < { \l_kipsol_large_below_dim }
          { \dim_set:Nn \l_kipsol_large_auto_dim { \l_kipsol_large_above_dim } }
          { \dim_set:Nn \l_kipsol_large_auto_dim { \l_kipsol_large_below_dim } }
        \dim_compare:nNnT { \l_kipsol_large_auto_dim } < { 0.0001pt }
          { \dim_set:Nn \l_kipsol_large_auto_dim { 0.5 \l_kipsol_xheight_dim } }
        \fp_set:Nn \l_kipsol_large_radius_fp
          {
            \kipsol_dim_to_pt:n { \l_kipsol_large_auto_dim }
            / \kipsol_dim_to_pt:n { \l_kipsol_xheight_dim }
          }
      }
    \fp_set:Nn \l_kipsol_large_radius_fp { \l_kipsol_large_radius_fp * \l_kipsol_scale_fp }
    \fp_set:Nn \l_kipsol_small_radius_fp { \l_kipsol_small_radius_fp * \l_kipsol_scale_fp }
    \fp_set:Nn \l_kipsol_pivot_radius_fp { \l_kipsol_pivot_radius_fp * \l_kipsol_scale_fp }
    \fp_set:Nn \l_kipsol_eow_radius_fp { \l_kipsol_eow_radius_fp * \l_kipsol_scale_fp }
    \fp_set:Nn \l_kipsol_padding_fp { \l_kipsol_padding_fp * \l_kipsol_scale_fp }
    \fp_set:Nn \l_kipsol_margin_fp { \l_kipsol_margin_fp * \l_kipsol_scale_fp }
  }

\cs_new_protected:Npn \kipsol_options_apply:n #1
  {
    \kipsol_options_reset:
    \tl_if_blank:nF {#1}
      {
        \tl_if_in:nnTF {#1} { = }
          { \keys_set:nn { kipsol/command } {#1} }
          { \fp_set:Nn \l_kipsol_scale_fp {#1} }
      }
    \kipsol_resolve_auto_metrics:
    \kipsol_copy_mode_apply:
  }

\cs_new_protected:Npn \kipsol_symbol_large:nnn #1#2#3
  {
    \group_begin:
      \kipsol_options_apply:n {#1}
      \kipsolrawconsonant[1]
        { \fp_to_decimal:N \l_kipsol_large_radius_fp } {#2} {#3}
        { \fp_to_decimal:N \l_kipsol_spoke_offset_fp }
        { \fp_to_decimal:N \l_kipsol_pivot_radius_fp }
        { \fp_to_decimal:N \l_kipsol_small_radius_fp }
        { \fp_to_decimal:N \l_kipsol_center_fp }
    \group_end:
  }

\cs_new_protected:Npn \kipsol_symbol_small:nnn #1#2#3
  {
    \group_begin:
      \kipsol_options_apply:n {#1}
      \kipsolrawconsonant[1]
        { \fp_to_decimal:N \l_kipsol_small_radius_fp } {#2} {#3}
        { \fp_to_decimal:N \l_kipsol_spoke_offset_fp }
        { \fp_to_decimal:N \l_kipsol_pivot_radius_fp }
        { \fp_to_decimal:N \l_kipsol_small_radius_fp }
        { \fp_to_decimal:N \l_kipsol_center_fp }
    \group_end:
  }

\cs_new_protected:Npn \kipsol_symbol_eow:n #1
  {
    \group_begin:
      \kipsol_options_apply:n {#1}
      \kipsolraweow[1]
        { \fp_to_decimal:N \l_kipsol_eow_radius_fp }
        { \fp_to_decimal:N \l_kipsol_center_fp }
    \group_end:
  }

\cs_new_protected:Npn \kipsol_symbol_vowel:nn #1#2
  {
    \group_begin:
      \kipsol_options_apply:n {#1}
      \kipsolrawvowelmark[\fp_to_decimal:N \l_kipsol_scale_fp]{#2}
    \group_end:
  }

