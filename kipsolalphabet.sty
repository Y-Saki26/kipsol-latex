\cs_new_protected:Npn \kipsol_pdf_literal_direct:n #1
  {
    \ifPDFTeX
      \pdfliteral direct {#1}
    \else
      \ifLuaTeX
        \pdfextension literal direct {#1}
      \else
        \special{pdf:literal\space direct\space #1}
      \fi
    \fi
  }

\cs_new_protected:Npn \kipsol_actual_text:nn #1#2
  {
    \BeginAccSupp{method=plain,ActualText={#1}}
      #2
    \EndAccSupp{}
  }

\cs_new_protected:Npn \kipsol_copy_text_wrap:nn #1#2
  {
    \bool_if:NTF \l_kipsol_copy_actualtext_bool
      { \kipsol_actual_text:nn {#1} {#2} }
      { #2 }
  }

\cs_new_protected:Npn \kipsol_copy_space:
  {
    \bool_if:NTF \l_kipsol_copy_actualtext_bool
      {
        \BeginAccSupp{method=plain,ActualText={\space}}
          \quad
        \EndAccSupp{}
      }
      { \quad }
  }

\cs_new_protected:Npn \kipsol_invisible_copy_text:n #1
  {
    \bool_if:NT \l_kipsol_copy_invisible_bool
      {
        \leavevmode
        \rlap
          {
            \smash
              {
                \kipsol_pdf_literal_direct:n { 3\space Tr }
                \normalfont #1
                \kipsol_pdf_literal_direct:n { 0\space Tr }
              }
          }
      }
  }

\cs_new_protected:Npn \kipsol_letter:n #1
  {
    \str_case:enF { \str_lowercase:n {#1} }
      {
        {z}{\KipsolZ}
        {d}{\KipsolD}
        {g}{\KipsolG}
        {b}{\KipsolB}
        {l}{\KipsolL}
        {n}{\KipsolN}
        {s}{\KipsolS}
        {t}{\KipsolT}
        {k}{\KipsolK}
        {p}{\KipsolP}
        {i}{\KipsolI}
        {o}{\KipsolO}
        {u}{\KipsolU}
      }
      {\texttt{#1}}
  }

\NewDocumentCommand{\KipsolLetters}{m}
  {
    \tl_map_inline:nn {#1}
      {
        \kipsol_letter:n {##1}\kern0.16em
      }
  }

\cs_new_protected:Npn \kipsol_word_init:n #1
  {
    \tl_set:Nn \l_kipsol_word_tl {#1}
    \fp_zero:N \l_kipsol_cursor_x_fp
    \fp_zero:N \l_kipsol_cursor_y_fp
    \fp_zero:N \l_kipsol_cursor_radius_fp
    \fp_zero:N \l_kipsol_cursor_direction_fp
    \fp_set:Nn \l_kipsol_min_x_fp { 1000 }
    \fp_set:Nn \l_kipsol_max_x_fp { -1000 }
    \fp_set:Nn \l_kipsol_min_y_fp { 1000 }
    \fp_set:Nn \l_kipsol_max_y_fp { -1000 }
    \fp_set:Nn \l_kipsol_rotation_factor_fp { 1 }
    \fp_zero:N \l_kipsol_previous_consonant_radius_fp
    \bool_set_false:N \l_kipsol_has_item_bool
    \bool_set_false:N \l_kipsol_consonant_seen_bool
    \bool_set_false:N \l_kipsol_previous_consonant_bool
    \bool_set_true:N \l_kipsol_clockwise_bool
    \bool_set_false:N \l_kipsol_abort_bool
    \tl_clear:N \l_kipsol_previous_type_tl
    \tl_clear:N \l_kipsol_error_tl
    \seq_clear:N \l_kipsol_connectors_seq
    \seq_clear:N \l_kipsol_glyphs_seq
  }

\cs_new_protected:Npn \kipsol_abort:n #1
  {
    \bool_set_true:N \l_kipsol_abort_bool
    \tl_set:Nn \l_kipsol_error_tl {#1}
  }

\cs_new_protected:Npn \kipsol_include_circle:nnn #1#2#3
  {
    \fp_set:Nn \l_kipsol_min_x_fp { min(\l_kipsol_min_x_fp, (#1) - (#3)) }
    \fp_set:Nn \l_kipsol_max_x_fp { max(\l_kipsol_max_x_fp, (#1) + (#3)) }
    \fp_set:Nn \l_kipsol_min_y_fp { min(\l_kipsol_min_y_fp, (#2) - (#3)) }
    \fp_set:Nn \l_kipsol_max_y_fp { max(\l_kipsol_max_y_fp, (#2) + (#3)) }
  }

\cs_new_protected:Npn \kipsol_set_consonant:n #1
  {
    \str_case:enF { \str_lowercase:n {#1} }
      {
        {z}{ \fp_set_eq:NN \l_kipsol_next_radius_fp \l_kipsol_large_radius_fp \int_zero:N \l_kipsol_spokes_int \int_zero:N \l_kipsol_inner_int }
        {d}{ \fp_set_eq:NN \l_kipsol_next_radius_fp \l_kipsol_large_radius_fp \int_set:Nn \l_kipsol_spokes_int {3} \int_zero:N \l_kipsol_inner_int }
        {g}{ \fp_set_eq:NN \l_kipsol_next_radius_fp \l_kipsol_large_radius_fp \int_set:Nn \l_kipsol_spokes_int {4} \int_zero:N \l_kipsol_inner_int }
        {b}{ \fp_set_eq:NN \l_kipsol_next_radius_fp \l_kipsol_large_radius_fp \int_set:Nn \l_kipsol_spokes_int {6} \int_zero:N \l_kipsol_inner_int }
        {l}{ \fp_set_eq:NN \l_kipsol_next_radius_fp \l_kipsol_large_radius_fp \int_zero:N \l_kipsol_spokes_int \int_set:Nn \l_kipsol_inner_int {1} }
        {n}{ \fp_set_eq:NN \l_kipsol_next_radius_fp \l_kipsol_large_radius_fp \int_set:Nn \l_kipsol_spokes_int {3} \int_set:Nn \l_kipsol_inner_int {1} }
        {s}{ \fp_set_eq:NN \l_kipsol_next_radius_fp \l_kipsol_small_radius_fp \int_zero:N \l_kipsol_spokes_int \int_zero:N \l_kipsol_inner_int }
        {t}{ \fp_set_eq:NN \l_kipsol_next_radius_fp \l_kipsol_small_radius_fp \int_set:Nn \l_kipsol_spokes_int {3} \int_zero:N \l_kipsol_inner_int }
        {k}{ \fp_set_eq:NN \l_kipsol_next_radius_fp \l_kipsol_small_radius_fp \int_set:Nn \l_kipsol_spokes_int {4} \int_zero:N \l_kipsol_inner_int }
        {p}{ \fp_set_eq:NN \l_kipsol_next_radius_fp \l_kipsol_small_radius_fp \int_set:Nn \l_kipsol_spokes_int {6} \int_zero:N \l_kipsol_inner_int }
      }
      { \kipsol_abort:n { Invalid~Kipsol~symbol } }
  }

\cs_new_protected:Npn \kipsol_append_line:nnnn #1#2#3#4
  {
    \seq_put_right:Nx \l_kipsol_connectors_seq
      { \exp_not:N \draw (#1,#2) -- (#3,#4); }
  }

\cs_new_protected:Npn \kipsol_append_glyph:
  {
    \seq_put_right:Nx \l_kipsol_glyphs_seq
      {
        \exp_not:N \draw
        ( \kipsol_fp:N \l_kipsol_next_x_fp , \kipsol_fp:N \l_kipsol_next_y_fp )
        circle ( \kipsol_fp:N \l_kipsol_next_radius_fp );
      }
    \seq_put_right:Nx \l_kipsol_glyphs_seq
      {
        \exp_not:N \fill
        ( \kipsol_fp:N \l_kipsol_next_x_fp , \kipsol_fp:N \l_kipsol_next_y_fp )
        circle ( \fp_to_decimal:N \l_kipsol_pivot_radius_fp );
      }
    \int_compare:nNnT \l_kipsol_inner_int > {0}
      {
        \seq_put_right:Nx \l_kipsol_glyphs_seq
          {
            \exp_not:N \draw
            ( \kipsol_fp:N \l_kipsol_next_x_fp , \kipsol_fp:N \l_kipsol_next_y_fp )
            circle ( \fp_to_decimal:N \l_kipsol_small_radius_fp );
          }
      }
    \int_compare:nNnT \l_kipsol_spokes_int > {0}
      {
        \int_step_inline:nn { \l_kipsol_spokes_int }
          {
            \fp_set:Nn \l_kipsol_angle_fp
              { \l_kipsol_item_spoke_offset_fp + 90 - 360 / \l_kipsol_spokes_int * (##1 - 1) }
            \fp_set:Nn \l_kipsol_endpoint_x_fp
              { \l_kipsol_next_x_fp + \l_kipsol_next_radius_fp * cosd(\l_kipsol_angle_fp) }
            \fp_set:Nn \l_kipsol_endpoint_y_fp
              { \l_kipsol_next_y_fp + \l_kipsol_next_radius_fp * sind(\l_kipsol_angle_fp) }
            \seq_put_right:Nx \l_kipsol_glyphs_seq
              {
                \exp_not:N \draw
                ( \kipsol_fp:N \l_kipsol_next_x_fp , \kipsol_fp:N \l_kipsol_next_y_fp )
                -- ( \kipsol_fp:N \l_kipsol_endpoint_x_fp , \kipsol_fp:N \l_kipsol_endpoint_y_fp );
              }
          }
      }
  }

\cs_new_protected:Npn \kipsol_process_vowel:n #1
  {
    \bool_if:NF \l_kipsol_has_item_bool
      { \kipsol_abort:n { Initial~vowel~is~not~allowed } }
    \tl_if_eq:NnT \l_kipsol_previous_type_tl { vowel }
      { \kipsol_abort:n { Continuous~vowels~are~not~allowed } }
    \bool_if:NF \l_kipsol_abort_bool
      {
        \str_case:en { \str_lowercase:n {#1} }
          {
            {i}{ \fp_set:Nn \l_kipsol_cursor_direction_fp { 45 } }
            {o}{ \fp_zero:N \l_kipsol_cursor_direction_fp }
            {u}{ \fp_set:Nn \l_kipsol_cursor_direction_fp { -45 } }
          }
        \tl_set:Nn \l_kipsol_previous_type_tl { vowel }
      }
  }

\cs_new_protected:Npn \kipsol_process_consonant:n #1
  {
    \kipsol_set_consonant:n {#1}
    \bool_if:NT \l_kipsol_abort_bool { \tl_map_break: }
    \fp_set_eq:NN \l_kipsol_next_x_fp \l_kipsol_cursor_x_fp
    \fp_set_eq:NN \l_kipsol_next_y_fp \l_kipsol_cursor_y_fp
    \bool_if:NT \l_kipsol_has_item_bool
      {
        \fp_set:Nn \l_kipsol_distance_fp
          { \l_kipsol_cursor_radius_fp + \l_kipsol_next_radius_fp }
        \tl_if_eq:NnT \l_kipsol_previous_type_tl { consonant }
          { \fp_add:Nn \l_kipsol_distance_fp { \l_kipsol_padding_fp } }
        \fp_set:Nn \l_kipsol_next_x_fp
          { \l_kipsol_cursor_x_fp + \l_kipsol_distance_fp * cosd(\l_kipsol_cursor_direction_fp) }
        \fp_set:Nn \l_kipsol_next_y_fp
          { \l_kipsol_cursor_y_fp + \l_kipsol_distance_fp * sind(\l_kipsol_cursor_direction_fp) }
        \tl_if_eq:NnT \l_kipsol_previous_type_tl { consonant }
          {
            \bool_set_inverse:N \l_kipsol_clockwise_bool
            \kipsol_append_line:nnnn
              { \kipsol_fp:N \l_kipsol_cursor_x_fp }
              { \kipsol_fp:N \l_kipsol_cursor_y_fp }
              { \kipsol_fp:N \l_kipsol_next_x_fp }
              { \kipsol_fp:N \l_kipsol_next_y_fp }
          }
      }
    \tl_if_eq:NnT \l_kipsol_previous_type_tl { vowel }
      {
        \bool_if:NT \l_kipsol_previous_consonant_bool
          {
            \fp_set:Nn \l_kipsol_rotation_factor_fp
              { \l_kipsol_rotation_factor_fp * \l_kipsol_previous_consonant_radius_fp / \l_kipsol_next_radius_fp }
          }
      }
    \bool_if:NTF \l_kipsol_clockwise_bool
      {
        \fp_set:Nn \l_kipsol_item_spoke_offset_fp
          { \l_kipsol_rotation_factor_fp * \l_kipsol_spoke_offset_fp }
      }
      {
        \fp_set:Nn \l_kipsol_item_spoke_offset_fp
          { - \l_kipsol_rotation_factor_fp * \l_kipsol_spoke_offset_fp }
      }
    \kipsol_append_glyph:
    \kipsol_include_circle:nnn
      { \l_kipsol_next_x_fp }
      { \l_kipsol_next_y_fp }
      { \l_kipsol_next_radius_fp }
    \fp_set_eq:NN \l_kipsol_cursor_x_fp \l_kipsol_next_x_fp
    \fp_set_eq:NN \l_kipsol_cursor_y_fp \l_kipsol_next_y_fp
    \fp_set_eq:NN \l_kipsol_cursor_radius_fp \l_kipsol_next_radius_fp
    \fp_set_eq:NN \l_kipsol_previous_consonant_radius_fp \l_kipsol_next_radius_fp
    \fp_zero:N \l_kipsol_cursor_direction_fp
    \bool_set_true:N \l_kipsol_has_item_bool
    \bool_set_true:N \l_kipsol_consonant_seen_bool
    \bool_set_true:N \l_kipsol_previous_consonant_bool
    \bool_set_inverse:N \l_kipsol_clockwise_bool
    \tl_set:Nn \l_kipsol_previous_type_tl { consonant }
  }

\cs_new_protected:Npn \kipsol_process_symbol:n #1
  {
    \bool_if:NTF \l_kipsol_abort_bool
      { \tl_map_break: }
      {
        \str_case:enF { \str_lowercase:n {#1} }
          {
            {i}{ \kipsol_process_vowel:n {#1} }
            {o}{ \kipsol_process_vowel:n {#1} }
            {u}{ \kipsol_process_vowel:n {#1} }
          }
          { \kipsol_process_consonant:n {#1} }
        \bool_if:NT \l_kipsol_abort_bool { \tl_map_break: }
      }
  }

\cs_new_protected:Npn \kipsol_finish_word:
  {
    \bool_if:NF \l_kipsol_abort_bool
      {
        \bool_if:NF \l_kipsol_consonant_seen_bool
          { \kipsol_abort:n { No~consonant~found } }
      }
    \bool_if:NF \l_kipsol_abort_bool
      {
        \fp_set:Nn \l_kipsol_distance_fp
          { \l_kipsol_cursor_radius_fp + \l_kipsol_eow_radius_fp }
        \tl_if_eq:NnT \l_kipsol_previous_type_tl { consonant }
          { \fp_add:Nn \l_kipsol_distance_fp { \l_kipsol_padding_fp } }
        \fp_set:Nn \l_kipsol_next_x_fp
          { \l_kipsol_cursor_x_fp + \l_kipsol_distance_fp * cosd(\l_kipsol_cursor_direction_fp) }
        \fp_set:Nn \l_kipsol_next_y_fp
          { \l_kipsol_cursor_y_fp + \l_kipsol_distance_fp * sind(\l_kipsol_cursor_direction_fp) }
        \tl_if_eq:NnT \l_kipsol_previous_type_tl { consonant }
          {
            \fp_set:Nn \l_kipsol_endpoint_x_fp
              { \l_kipsol_cursor_x_fp + (\l_kipsol_distance_fp - \l_kipsol_eow_radius_fp) * cosd(\l_kipsol_cursor_direction_fp) }
            \fp_set:Nn \l_kipsol_endpoint_y_fp
              { \l_kipsol_cursor_y_fp + (\l_kipsol_distance_fp - \l_kipsol_eow_radius_fp) * sind(\l_kipsol_cursor_direction_fp) }
            \kipsol_append_line:nnnn
              { \kipsol_fp:N \l_kipsol_cursor_x_fp }
              { \kipsol_fp:N \l_kipsol_cursor_y_fp }
              { \kipsol_fp:N \l_kipsol_endpoint_x_fp }
              { \kipsol_fp:N \l_kipsol_endpoint_y_fp }
          }
        \kipsol_include_circle:nnn
          { \l_kipsol_next_x_fp }
          { \l_kipsol_next_y_fp }
          { \l_kipsol_eow_radius_fp }
      }
  }

\cs_new_protected:Npn \kipsol_print_word:n #1
  {
    \msg_warning:nnxx { kipsolalphabet } { invalid-word }
      { \tl_use:N \l_kipsol_error_tl }
      {#1}
    \texttt{#1}
  }

\cs_new_protected:Npn \kipsol_word_render:nn #1#2
  {
    \group_begin:
      \kipsol_options_apply:n {#1}
      \kipsol_word_init:n {#2}
      \tl_if_blank:nTF {#2}
        { \kipsol_abort:n { Blank~word } }
        { \tl_map_inline:nn {#2} { \kipsol_process_symbol:n {##1} } }
      \kipsol_finish_word:
      \bool_if:NTF \l_kipsol_abort_bool
        { \kipsol_print_word:n {#2} }
        {
          \kipsol_copy_text_wrap:nn {#2}
            {
              \leavevmode
              \kipsol_invisible_copy_text:n {#2}
              \begin{tikzpicture}[
                x=1ex,
                y=1ex,
                scale=1,
                baseline=-\fp_to_decimal:N \l_kipsol_center_fp ex,
                line~width=0.08ex,
                line~cap=round,
                transform~shape
              ]
                \path[use~as~bounding~box]
                  ( { \fp_to_decimal:n { \l_kipsol_min_x_fp - \l_kipsol_margin_fp } },
                    { \fp_to_decimal:n { \l_kipsol_min_y_fp - \l_kipsol_margin_fp } } )
                  rectangle
                  ( { \fp_to_decimal:n { \l_kipsol_max_x_fp + \l_kipsol_margin_fp } },
                    { \fp_to_decimal:n { \l_kipsol_max_y_fp + \l_kipsol_margin_fp } } );
                \seq_use:Nn \l_kipsol_connectors_seq { }
                \seq_use:Nn \l_kipsol_glyphs_seq { }
                \draw
                  ( \kipsol_fp:N \l_kipsol_next_x_fp , \kipsol_fp:N \l_kipsol_next_y_fp )
                  circle ( \fp_to_decimal:N \l_kipsol_eow_radius_fp );
              \end{tikzpicture}
            }
        }
    \group_end:
  }

\NewDocumentCommand{\KipsolWord}{O{}m}
  {
    \kipsol_word_render:nn {#1} {#2}
  }

\NewDocumentCommand{\KipsolText}{O{}m}
  {
    \group_begin:
      \kipsol_options_apply:n {#1}
      \seq_set_split:Nnn \l_kipsol_words_seq { ~ } {#2}
      \int_zero:N \l_kipsol_word_index_int
      \seq_map_inline:Nn \l_kipsol_words_seq
        {
          \tl_if_blank:nF {##1}
            {
              \int_incr:N \l_kipsol_word_index_int
              \int_compare:nNnT \l_kipsol_word_index_int > {1}
                { \kipsol_copy_space: }
              \KipsolWord[#1]{##1}
            }
        }
    \group_end:
  }

\NewDocumentCommand{\KipsolTranscription}{m}{\KipsolText{#1}}

\ExplSyntaxOff
