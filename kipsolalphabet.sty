\tikzsymbolsdefinesymbol{kipsolrawconsonant}{
    S % scale
    m % radius in ex
    m % spoke count
    m % inner circle: 0 or 1
    m % spoke offset in degrees
    m % pivot radius in ex
    m % inner circle radius in ex
    m % center height above baseline in ex
}{%
    \begin{tikzpicture}[
        /tikzsymbolsstyle,
        x=1ex,
        y=1ex,
        scale=#1,
        baseline=-#8ex,
        line width=0.08ex,
        line cap=round,
        transform shape
    ]
        \draw (0,0) circle (#2);
        \fill (0,0) circle (#6);
        \ifnum#4>0
            \draw (0,0) circle (#7);
        \fi
        \ifnum#3>0
            \foreach \kipsol@i in {1,...,#3} {
                \draw (0,0) -- ({#5 + 90 - 360/#3*(\kipsol@i - 1)}:#2);
            }
        \fi
    \end{tikzpicture}%
}

\tikzsymbolsdefinesymbol{kipsolraweow}{
    S % scale
    m % radius in ex
    m % center height above baseline in ex
}{%
    \begin{tikzpicture}[
        /tikzsymbolsstyle,
        x=1ex,
        y=1ex,
        scale=#1,
        baseline=-#3ex,
        line width=0.08ex,
        transform shape
    ]
        \draw (0,0) circle (#2);
    \end{tikzpicture}%
}

\tikzsymbolsdefinesymbol{kipsolrawvowelmark}{
    S % scale
    m % direction in degrees
}{%
    \begin{tikzpicture}[
        /tikzsymbolsstyle,
        x=1ex,
        y=1ex,
        scale=#1,
        baseline=-0.5ex,
        line width=0.08ex,
        line cap=round,
        >=stealth,
        transform shape
    ]
        \draw[->] ({#2 + 180}:0.5) -- (#2:0.5);
    \end{tikzpicture}%
}

